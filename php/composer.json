        "disposable email api",
        "disposable email detection api",
        "temp mail detection api",
        "temp email checker api"
    ],
    "homepage": "https://apiverve.com/marketplace/emaildisposablechecker?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
